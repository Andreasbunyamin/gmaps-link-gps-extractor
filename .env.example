# Copy to .env and fill in. .env is gitignored - never commit the real values.

# Input workbook. Keep real data outside the repo, or in data/ (gitignored).
GMAPS_INPUT_FILE=data/sample_tourist_places.xlsx
GMAPS_INPUT_SHEET=PLACES
GMAPS_LINK_COLUMN=LINK GMAPS

# Where results are written
GMAPS_OUTPUT_FILE=output/gps_coordinates.xlsx

# Optional: Google Drive folder to upload results into.
# Find the ID in the folder URL: drive.google.com/drive/folders/<THIS-PART>
GDRIVE_FOLDER_ID=
